{
  "extends": "astro/tsconfigs/base",
  "include": [
    "./src/**/*",
    "./worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@public/*": ["public/*"],
      "@components/*": ["src/components/*"]
    }
  }
}