---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { Image } from "astro:assets";
import ContactForm from "../components/ContactForm.astro";
import HeroImage from "../../public/images/HAWKINS-248.avif";
---

<Layout>
    <Header theme="light" />
    <div class="section">
        <div class="container">
            <div class="content-grid">
                <div class="image-wrapper" data-delay="2">
                    <Image
                        src={HeroImage}
                        alt="Portrait of Aron Hawkins"
                        class="hero-portrait"
                    />
                </div>
                <div>
                    <h1>Reach Out</h1>
                    <p>
                        Pharetra montes mattis accumsan; tellus porttitor ante.
                        Ut suscipit adipiscing est enim interdum pulvinar
                        sagittis curabitur turpis.
                    </p>
                    <ContactForm theme="light" />
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .section {
        background-color: var(--cream);
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: center;
        position: relative;
    }

    .image-wrapper {
        position: relative;
        width: 100%;
        height: auto;
        aspect-ratio: 4/5;
        overflow: hidden;
        border-radius: 0.5rem;
        flex: 1;
    }

    .image-wrapper img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: bottom;
    }

    h1 {
        font-size: 3rem;
        font-weight: 500;
        color: var(--red);
        margin-bottom: 1rem;
    }

    p {
        color: rgb(from var(--brown) r g b / 0.75);
        margin-bottom: 2.5rem;
    }
</style>
