---
import Layout from "@/layouts/Layout.astro";
import Header from "@components/Header.astro";
import BouncingLogo from "@components/BouncingLogo.astro";
import NotFoundImage from "@/assets/images/aronhawkins-23.webp";
import { Image } from "astro:assets";
---

<Layout>
    <Header />
    <a id="top"></a>
    <BouncingLogo />
    <main>
        <section class="section">
            <div class="container">
                <div class="not-found-grid">
                    <div>
                        <div class="image-container">
                            <Image src={NotFoundImage} alt="Aron Hawkins" />
                        </div>
                    </div>
                    <div>
                        <h1>404 <span>Page Not Found</span></h1>
                        <p>
                            Not sure how we ended up here, but the page you
                            tried to go to doesn't exist.
                        </p>
                        <a href="/" class="btn btn-primary">Head Home</a>
                    </div>
                </div>
            </div>
        </section>
    </main></Layout
>

<style>
    .section {
        min-height: calc(100vh - 22rem);
        position: relative;
        z-index: 1;
    }
    .container {
        padding-block: 8rem 5rem;
    }

    h1 {
        /* text-align: center; */
        font-size: 6.5rem;
        line-height: 1.25;
        margin-bottom: 1.5rem;
    }

    h1 span {
        display: block;
        font-size: 2.5rem;
    }

    p {
        /* text-align: center; */
        margin-bottom: 2.5rem;
    }

    a {
        /* display: block; */
        /* width: fit-content; */
        /* margin: auto; */
    }

    .not-found-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7.5rem;
        align-items: center;
    }

    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 1rem;
    }

    .image-container img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media screen and (max-width: 1024px) {
        .not-found-grid {
            gap: 5rem;
        }

        .image-container {
            aspect-ratio: 4/5;
        }
    }

    @media screen and (max-width: 767px) {
        .not-found-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        div:has(> .image-container) {
            aspect-ratio: 1;
            order: 1;
        }
    }
</style>
