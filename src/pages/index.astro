---
import Layout from "@/layouts/Layout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/pages/Home/Hero.astro";
import Services from "@components/pages/Home/Services.astro";
import Work from "@components/pages/Home/Work.astro";
import Contact from "@components/pages/Home/Contact.astro";
import Testimonials from "@components/pages/Home/Testimonials.astro";
import OgImage from "@/assets/images/aronhawkins-78.webp";
---

<Layout imageSrc={OgImage.src}>
  <Header />
  <a id="top"></a>
  <main>
    <Hero />
    <Services />
    <Work />
    <Testimonials />
    <Contact />
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: auto;
  }
</style>
