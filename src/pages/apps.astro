---
import Layout from "@/layouts/Layout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/services/Apps/Hero.astro";
import ServiceColumns from "@components/services/Apps/ServiceColumns.astro";
import Clients from "@components/services/Apps/Clients.astro";
import Testimonials from "@components/services/Apps/Testimonials.astro";
import OgImage from "@/assets/images/aronhawkins-97.webp";
---

<Layout
    title="Web & Mobile Apps | Services | Aron Hawkins Software Development"
    description="Aron Hawkins develops web and mobile applications that make your life easier and that you actually enjoy using."
    imageSrc={OgImage.src}
>
    <Header theme="light" />
    <a id="top"></a>
    <main>
        <Hero />
        <Clients />
        <ServiceColumns />
        <Testimonials />
    </main>
</Layout>
