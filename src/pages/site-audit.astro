---
import Layout from "@/layouts/Layout.astro";
import Header from "@components/Header.astro";
import Testimonials from "@components/pages/About/Testimonials.astro";
import Hero from "@components/pages/SiteAudit/Hero.astro";
import Benefits from "@components/pages/SiteAudit/Benefits.astro";
import Giveaway from "@components/pages/SiteAudit/Giveaway.astro";
import OgImage from "@/assets/images/IMG_5168.webp";
import { abs, auditServiceNode, breadcrumb } from "@/data/schema";

const url = abs("/site-audit");
const description =
  "Get an audit of your existing website! You will receive a comprehensive PDF document detailing how you can improve your site's SEO, performance, accessibility, and functionality.";
---

<Layout
  title="Site Audit | Aron Hawkins Software Development"
  description={description}
  imageSrc={OgImage.src}
  mainEntity={`${url}#service`}
  schema={[
    breadcrumb(url, [
      { name: "Home", path: "/" },
      { name: "Site Audit", path: "/site-audit" },
    ]),
    auditServiceNode(url, description),
  ]}
>
  <Header theme="light" />
  <a id="top"></a>
  <main>
    <Hero />
    <Benefits />
    <Giveaway />
    <Testimonials />
  </main>
</Layout>
