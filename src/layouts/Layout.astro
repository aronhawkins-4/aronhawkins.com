---
import "@/styles/global.css";
import Footer from "@components/Footer.astro";
import PostHog from "@components/posthog.astro";
// Favicon recolors itself via an embedded `prefers-color-scheme` media query —
// terracotta on light browser chrome, cream on dark. See the <style> block in
// the file itself; the light color is the default so it degrades gracefully.
import favicon from "@/assets/images/brand/Brand_Icon-adaptive.svg";
import Schema from "@components/Schema.astro";
import { abs, coreGraph, webPage } from "@/data/schema";

interface Props {
	title?: string;
	description?: string;
	imageSrc?: string;
	/** Suppresses indexing. Set on error pages. */
	noindex?: boolean;
	/** Narrows the page-level node, e.g. "AboutPage", "ContactPage". */
	pageType?: string;
	/** `@id` of the node this page is primarily about, if not the practice. */
	mainEntity?: string;
	/** Route-specific JSON-LD nodes, layered onto the site-wide graph. */
	schema?: object[];
}
const {
	title = "Aron Hawkins | Apps • Sites • Automation",
	description = "Full-stack developer in Texas, building apps that make life easier, websites that convert, and automations that save time.",
	imageSrc,
	noindex = false,
	pageType,
	mainEntity,
	schema = [],
} = Astro.props;

// Open Graph requires absolute URLs — `imageSrc` comes in as a root-relative
// asset path, so resolve it against the configured `site`.
const ogImage = imageSrc ? new URL(imageSrc, Astro.site).href : undefined;
// `abs()` normalizes the trailing slash. The build emits directory-style routes
// (`/apps/`) but `astro dev` serves `/apps`, and the schema `@id`s built in
// `schema.ts` are derived from this same helper — without the normalization the
// graph's references would resolve in production but dangle in dev.
const ogUrl = abs(Astro.url.pathname);

// Every indexed page emits the same three identity nodes (Person, the practice,
// the site) plus its own WebPage node; routes add page-specific nodes on top.
// `@id` references between them are what let crawlers resolve one entity rather
// than a pile of unrelated snippets. Error pages emit nothing.
const graph = noindex
	? []
	: [
			...coreGraph(),
			webPage({
				url: ogUrl,
				name: title,
				description,
				image: ogImage,
				type: pageType,
				mainEntity,
				hasBreadcrumb: schema.some(
					(node) => (node as { "@type"?: string })["@type"] === "BreadcrumbList",
				),
			}),
			...schema,
		];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Aron Hawkins" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={ogUrl} />
		<link rel="canonical" href={ogUrl} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta
			name="twitter:card"
			content={ogImage ? "summary_large_image" : "summary"}
		/>
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<title>{title}</title>
		{graph.length > 0 && <Schema nodes={graph} />}
		<PostHog />
	</head>
	<body>
		<slot />
		<Footer />
		<script>
			import { animate, inView, stagger } from "motion";
			document.addEventListener("DOMContentLoaded", () => {
				(function () {
					// Sticky header
					const header = document.getElementById("header");
					const onScroll = () =>
						header?.classList.toggle(
							"scrolled",
							window.scrollY > 24,
						);
					onScroll();
					window.addEventListener("scroll", onScroll, {
						passive: true,
					});
				})();

				(function () {
					// Mobile nav
					const toggle = document.getElementById("navtoggle");
					const links = document.getElementById("navlinks");
					toggle?.addEventListener("click", () => {
						const open = links?.classList.toggle("open");
						toggle.classList.toggle("open", open);
						toggle.setAttribute(
							"aria-expanded",
							open ? "true" : "false",
						);
						if (open) links?.querySelector<HTMLElement>("a, button")?.focus();
					});
					const closeMenu = () => {
						links?.classList.remove("open");
						toggle?.classList.remove("open");
						toggle?.setAttribute("aria-expanded", "false");
					};
					links
						?.querySelectorAll("a")
						.forEach((a) => a.addEventListener("click", closeMenu));
					document.addEventListener("click", (e) => {
						if (!links?.classList.contains("open")) return;
						const target = e.target as Node;
						if (
							!links.contains(target) &&
							!toggle?.contains(target)
						) {
							closeMenu();
						}
					});
					document.addEventListener("keydown", (e) => {
						if (!links?.classList.contains("open")) return;
						if (e.key === "Escape") {
							closeMenu();
							toggle?.focus();
						} else if (
							e.key === "Tab" &&
							!e.shiftKey &&
							document.activeElement === toggle
						) {
							e.preventDefault();
							links.querySelector<HTMLElement>("a, button")?.focus();
						}
					});
				})();

				// Entrance Animations
				(function () {
					animate(
						".reveal.reveal-on-load",
						{ opacity: [0, 1], y: [20, 0] },
						{
							duration: 0.7,
							type: "spring",
							bounce: 0.3,
							delay: stagger(0.1),
						},
					);
					inView(
						".reveal:not(.reveal-on-load)",
						(element) => {
							animate(
								element,
								{ opacity: [0, 1], y: [20, 0] },
								{ duration: 0.7, type: "spring", bounce: 0.3 },
							);
						},
						{
							margin: "0px 0px -100px 0px",
						},
					);
					inView(
						".reveal-stagger",
						(element) => {
							animate(
								element.querySelectorAll(".stagger-target"),
								{ opacity: [0, 1], y: [20, 0] },
								{
									duration: 0.7,
									type: "spring",
									bounce: 0.3,
									delay: stagger(0.1),
								},
							);
						},
						{
							margin: "0px 0px -100px 0px",
						},
					);
				})();
			});
		</script>
	</body>
</html>
