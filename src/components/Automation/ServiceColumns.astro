---
import { Image } from "astro:assets";
import MobileImage from "../../../public/images/apps-stock-image.webp";
import WebAppMockup from "../../../public/images/web_app_mockup.webp";
---

<div class="section">
    <div class="container">
        <div class="grid">
            <div class="content-column">
                <h2>Automations</h2>
                <p>
                    I build automations that connect the tools you already use
                    and quietly handle the busywork in the background. I stay
                    hands-on through every step.
                </p>
                <div class="steps">
                    <div class="step">
                        <h3>System Integrations</h3>
                        <p>
                            Custom connections between the apps that don't talk
                            to each other out of the box, so your data stays in
                            sync and no one is copying it by hand.
                        </p>
                    </div>
                    <div class="step">
                        <h3>AI-Powered Workflows</h3>
                        <p>
                            Summarizing documents, drafting replies, tagging and
                            triaging requests — AI applied where it saves real
                            hours, securely wired into your own business data.
                        </p>
                    </div>
                    <div class="step">
                        <h3>Lead &amp; CRM Automation</h3>
                        <p>
                            New leads captured, enriched, routed to the right
                            person, and followed up with automatically — so
                            nothing sits in an inbox going cold.
                        </p>
                    </div>
                    <div class="step">
                        <h3>Regular Reporting</h3>
                        <p>
                            Reports generated automatically from your data,
                            dashboards updated in real-time, and insights
                            delivered without manual effort. Consistent
                            visibility into your business performance.
                        </p>
                    </div>
                    <div class="step">
                        <h3>Invoicing &amp; Payments</h3>
                        <p>
                            Invoices generated and sent on schedule, payments
                            reconciled, and reminders chasing overdue accounts
                            so you don't have to.
                        </p>
                    </div>
                </div>
                <div class="cta">
                    <a href="/contact" class="btn btn-primary">Contact me</a>
                    <a href="/#work" class="btn btn-outline">See my work</a>
                </div>
            </div>
            <div class="image-column">
                <div class="image-wrapper">
                    <Image src={MobileImage} alt="Mobile App" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7.5rem;
        align-items: center;
    }

    .grid:first-child {
        /* margin-bottom: 7.5rem; */
    }

    .image-wrapper {
        width: 100%;
        aspect-ratio: 4/5;
        overflow: hidden;
        border-radius: 0.5rem;
        position: relative;
    }
    .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .content-column h2 {
        margin-bottom: 1rem;
    }

    .content-column > p {
        margin-bottom: 2.5rem;
        color: rgb(var(--cream) r g b / 0.75);
    }

    .steps {
        display: grid;
        gap: 1.75rem;
        margin-bottom: 2.5rem;
    }

    .step h3 {
        color: var(--gold);
        margin-bottom: 0.375rem;
    }

    .step p {
        color: rgb(var(--cream) r g b / 0.75);
    }

    .content-column p span {
        opacity: 1;
        background: var(--red);
    }

    .cta {
        display: flex;
        gap: 0.875rem;
        flex-wrap: wrap;
        align-items: center;
    }
</style>
