---
import { Image } from "astro:assets";
import AronImage from "@/assets/images/aronhawkins-19.webp";
import { ClientCarousel } from "@components/ClientCarousel/ClientCarousel";
---

<section class="section hero">
	<div class="container">
		<div class="hero-grid">
			<div class="hero-content">
				<h1 class="reveal reveal-on-load">Apps, Sites & Automation</h1>
				<p class="reveal reveal-on-load">
					I'm Aron Hawkins, a fullstack software developer in Texas. I
					build web and mobile applications that <span
						>make life easier</span
					>, websites that <span>convert customers</span>, and
					automation workflows that <span>save time</span> for the things
					you actually want to do.
				</p>
				<div class="hero-cta reveal reveal-on-load">
					<a href="/contact" class="btn btn-primary">Contact me</a>
					<a href="#work" class="btn btn-outline">See my work</a>
				</div>
			</div>
			<div class="image-column">
				<div class="image-wrapper reveal">
					<Image
						src={AronImage}
						alt="Aron Hawkins sitting at a counter with a computer and smiling"
						widths={[480, 960, 1440]}
						sizes="(max-width: 800px) 100vw, 800px"
						class="hero-portrait"
					/>
				</div>
			</div>
		</div>
		<h2 class="reveal">Who I have worked with</h2>
		<ClientCarousel client:load />
	</div>
</section>

<style>
	.hero {
		position: relative;
		background-color: var(--brown);
	}

	.hero .container {
		padding-block: 8rem 5rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 0.5fr;
		gap: 7.5rem;
		align-items: center;
		position: relative;
		margin-bottom: 4rem;
	}

	.hero-content {
		max-width: 41rem;
	}

	/* .hero-content {
		align-self: start;
		position: sticky;
		top: 8.5rem;
		margin-top: 4rem;
	} */
	.hero h1 {
		font-size: 3rem;
		color: var(--cream);
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.hero h2 {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 2rem;
	}

	.hero p {
		font-size: 1rem;
		color: var(--cream);
		opacity: 0.75;
		/* max-width: 30em; */
		margin-bottom: 2.5rem;
		text-wrap: pretty;
	}

	.hero p span {
		opacity: 1;
		background: var(--red);
	}

	.hero-cta {
		display: flex;
		gap: 0.875rem;
		flex-wrap: wrap;
		align-items: center;
		/* margin-bottom: 4rem; */
	}

	.image-column {
		position: relative;
	}
	.image-wrapper {
		position: relative;
		width: 100%;
		height: auto;
		aspect-ratio: 4/5;
		overflow: hidden;
		border-radius: 0.5rem;
		/* border-bottom-left-radius: 2.5rem; */
		flex: 1;
	}

	.image-wrapper img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@media screen and (max-width: 1024px) {
		.hero-grid {
			gap: 4rem;
		}
	}
	@media screen and (max-width: 767px) {
		.hero-grid {
			grid-template-columns: 1fr;
			margin-bottom: 5rem;
			/* gap: 2.5rem; */
		}

		.hero-content {
			position: static;
			top: auto;
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.hero p {
			max-width: 100%;
		}

		.image-wrapper {
			/* order: -1; */
		}
	}
</style>
