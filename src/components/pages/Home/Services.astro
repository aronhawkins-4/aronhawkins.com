---
import { services } from "@/data/services";
---

<section class="section services" id="services">
	<div class="container">
		<div class="svc-head">
			<h2 class="reveal">My Services</h2>
			<p class="reveal">
				Web and mobile apps tailored to your business, dynamic websites
				that market your brand and sell your products, and automations
				that handle the busywork.
			</p>
		</div>
		<div class="svc-list reveal-stagger">
			{
				services.map((s, i) => (
					<div class="svc stagger-target">
						<h3>{s.name}</h3>
						<p>{s.description}</p>
						<a href={`/${s.slug}`} class="svc-button btn">
							Learn More
						</a>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* SERVICES */
	.services {
		background: var(--cream);
	}

	.svc-head {
		max-width: 50rem;
		margin-bottom: 4rem;
	}

	.svc-head h2 {
		margin-bottom: 1rem;
	}

	.svc-head p {
		color: rgb(from var(--brown) r g b / 0.75);
		font-size: 1rem;
	}
	.services h2 {
		color: var(--red);
		font-weight: 500;
	}

	.svc-list {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 1rem;
	}

	.svc {
		padding: 2.5rem;
		background: var(--red);
		border-radius: 0.5rem;
		box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.svc h3 {
		font-family: var(--general-sans);
		font-size: 2.5rem;
		font-weight: 500;
		color: var(--cream);
		margin-bottom: 1rem;
	}

	.svc p {
		font-size: 1rem;
		color: rgb(from var(--cream) r g b / 1);
		margin-bottom: 2rem;
	}

	.svc-button {
		color: var(--brown);
		background-color: var(--cream);
		margin-top: auto;
		width: fit-content;
	}

	.svc-button:hover {
		background: var(--brown);
		color: var(--cream);
	}

	@media screen and (max-width: 1024px) {
		.svc-list {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media screen and (max-width: 767px) {
		.svc-list {
			grid-template-columns: 1fr;
		}

		.svc {
			/* display: grid; */
			flex-direction: column;
			/* grid-template-columns: 1fr 1fr; */
			/* grid-template-rows: auto auto; */
			align-items: flex-start;
			gap: 1rem;
			/* align-items: end; */
		}
		.svc-right {
			align-items: flex-start;
			max-width: 100%;
			grid-column: 1 / span 2;
		}
		.svc h3 {
			font-size: 2rem;
		}

		.mockup {
			/* order: -1; */
			/* margin-left: auto; */
			max-width: 10rem;
			display: none;
		}
	}
</style>
