---
import { ProjectsCarousel } from "@components/ProjectsCarousel/ProjectsCarousel";
---

<section id="work" class="section">
	<div class="container">
		<div class="sec-head">
			<h2 class="reveal">What I've Built</h2>
			<p class="reveal">
				A selection of some of my recent projects, spanning industries
				including Real Estate, Hospitality, Retail, Fitness,
				Productivity, and AI.
			</p>
		</div>
	</div>
	<ProjectsCarousel client:load />
</section>

<style>
	section {
		background-color: var(--brown);
		padding-inline: 0;
		padding-bottom: 7.5rem;
	}

	.container {
		padding-bottom: 0;
		padding-inline: 2.5rem;
		max-width: calc(var(--maxw) + 5rem);
	}

	.sec-head {
		max-width: 40rem;
		margin-bottom: 4rem;
	}

	.sec-head h2 {
		margin-bottom: 1rem;
	}
	.work-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2.5rem;
	}

	@media screen and (max-width: 767px) {
		section {
			padding-inline: 1.25rem;
		}
		.container {
			padding-inline: 0;
		}
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
