---
import ContactForm from "@components/ContactForm.astro";
---

<section class="section" id="contact">
	<div class="container contact-grid">
		<div class="">
			<h2 class="reveal">Let's Connect</h2>
			<p class="sub reveal">
				I usually reply within a day or two. The fastest way to get a
				project started is to fill out this form.
			</p>
		</div>

		<ContactForm theme="light" class="reveal" />
	</div>
</section>

<style>
	/* CONTACT */
	.section {
		background: var(--cream);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 4rem;
		align-items: start;
	}

	h2 {
		margin-bottom: 1rem;
		color: var(--red);
	}

	p {
		color: rgb(from var(--brown) r g b / 0.75);
	}

	.contact .detail {
		margin-top: 1.875rem;
	}

	p a,
	.contact .detail a {
		border-bottom: 0.0625rem solid var(--red);
		color: var(--red);
		transition:
			color 0.15s var(--ease),
			border-color 0.15s var(--ease);
	}

	p a:hover {
		color: var(--brown);
		border-color: var(--brown);
	}

	@media screen and (max-width: 767px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
