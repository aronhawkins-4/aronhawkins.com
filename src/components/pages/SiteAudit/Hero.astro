---
import { Image } from "astro:assets";
import HeroImage from "@/assets/images/IMG_5168.webp";
import Check from "@/assets/icons/check-duotone-regular-full.svg";
---

<section class="section hero">
	<div class="container">
		<div class="hero-grid">
			<div class="image-column">
				<div class="image-wrapper reveal">
					<Image
						src={HeroImage}
						alt="Aron Hawkins and his family"
						class="hero-portrait"
						loading={"eager"}
					/>
				</div>
			</div>
			<div class="hero-content">
				<p class="eyebrow reveal reveal-on-load">Limited time offering</p>
				<h1 class="reveal reveal-on-load">Site Audits</h1>
				<p class="reveal reveal-on-load">
					Get an audit of up to 10 pages on your existing website and a
					comprehensive PDF writeup of exactly what to fix, why it
					matters, and how to do it.
				</p>
				<h2 class="reveal reveal-on-load">Categories Covered</h2>
				<ul class="reveal reveal-on-load">
					<li><Check width="20" /> SEO</li>
					<li><Check width="20" /> Performance</li>
					<li><Check width="20" /> Accessibility</li>
					<li><Check width="20" /> Functionality</li>
				</ul>
				<div class="audit-details reveal reveal-on-load">
					<p class="audit-spots">Remaining spots: 5</p>
					<p class="audit-price">Price: $300</p>
				</div>
				<form
					action="/api/create-checkout-session"
					method="POST"
					class="reveal reveal-on-load"
				>
					<button type="submit" class="btn btn-tertiary hover-alt"
						>Get your site audit</button
					>
				</form>
			</div>
		</div>
	</div>
</section>

<style>
	/* HERO */
	.hero {
		position: relative;
		background-color: var(--cream);
		padding-bottom: 5rem;
	}

	.hero .container {
		padding-block: 8rem 0rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 7.5rem;
		align-items: center;
		position: relative;
		/* margin-bottom: 5rem; */
	}

	.hero h1 {
		/* font-size: 2.5rem; */
		color: var(--red);
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.hero-content {
		/* align-self: start; */
	}

	.hero-right {
		align-self: end;
	}

	.hero h2 {
		color: var(--red);
	}

	.hero-content h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.hero p {
		font-size: 1rem;
		color: rgb(from var(--brown) r g b / 0.75);
	}

	.hero p:first-of-type {
		margin-bottom: 1rem;
	}

	.hero p:last-of-type {
		margin-bottom: 2.5rem;
	}

	/* .hero p span {
		opacity: 1;
		background: var(--red);
		color: var(--cream);
	} */

	.hero ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}

	.hero li {
		color: rgb(from var(--brown) r g b / 0.75);
		display: flex;
		align-items: start;
		gap: 0.5rem;
	}

	.hero li svg {
		color: var(--red);
		margin-top: 0.075rem;
	}

	.hero p.eyebrow {
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(from var(--brown) r g b / 0.75);
		margin-bottom: 0.5rem;
	}

	.audit-details {
		/* display: flex;

		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap; */
		margin-bottom: 1.5rem;
	}

	.hero .audit-details p {
		margin: 0;
	}

	.hero .audit-price {
		font-family: var(--general-sans);
		font-size: 2rem;
		font-weight: 500;
		color: var(--brown);
		text-transform: uppercase;
	}

	.image-column {
		position: relative;
	}
	.image-wrapper {
		position: relative;
		width: 100%;
		/* max-width: 25rem; */
		margin: auto;
		height: auto;
		aspect-ratio: 4/5;
		overflow: hidden;
		border-radius: 0.5rem;
		flex: 1;
	}

	.image-wrapper img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 45% 50%;
	}

	@media screen and (max-width: 1024px) {
		.hero-grid {
			gap: 4rem;
			row-gap: 2.5rem;
			grid-template-columns: 1fr 1fr;
			/* grid-template-rows: auto 1fr; */
		}

		.image-column {
			grid-column: 1 / span 1;
			grid-row: 1 / -1;
		}

		.hero-right {
			align-self: start;
		}

		.hero h2 {
			font-size: 1.5rem;
		}
	}
	@media screen and (max-width: 767px) {
		.hero-grid {
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			/* gap: 2.5rem; */
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.image-column {
			grid-column: auto;
			grid-row: auto;
		}

		.hero p {
			max-width: 100%;
		}
	}
</style>
