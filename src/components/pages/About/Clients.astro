---
import { ClientCarousel } from "@components/ClientCarousel/ClientCarousel";
---

<div class="section">
    <div class="container">
        <h2 class="reveal">Who I have worked with</h2>
        <ClientCarousel client:load />
    </div>
</div>

<style>
    .section {
        background: var(--brown);
    }

    .container {
        padding-block: 4rem;
    }

    h2 {
        text-align: center;
        margin-bottom: 2rem;
        font-size: 2rem;
        text-wrap: pretty;
    }
</style>
