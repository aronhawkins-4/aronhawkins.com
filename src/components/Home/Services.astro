---
import { services } from "../../data/services";
import RightArrow from "../../icons/arrow-right-regular-full.svg";
import PhoneMockup from "../../icons/phone-mockup.svg";
import LaptopMockup from "../../icons/laptop-mockup.svg";
import AutomationMockup from "../../icons/automation-mockup.svg";
---

<section class="section services" id="services">
	<div class="container">
		<div class="svc-head">
			<h2>My Services</h2>
			<p>
				New builds, automation, upgrades to older systems, ongoing
				upkeep, and the occasional second opinion.
			</p>
		</div>
		<div class="svc-list">
			{
				services.map((s, i) => (
					<a href="#" class="svc " data-delay={i % 3}>
						<h3>{s.name}</h3>
						{() => {
							switch (s.name) {
								case "Apps":
									return (
										<PhoneMockup
											width={80}
											class="mockup"
										/>
									);
								case "Sites":
									return (
										<LaptopMockup
											width={160}
											class="mockup"
										/>
									);
								case "Automation":
									return (
										<AutomationMockup
											width={176}
											class="mockup"
										/>
									);
							}
						}}
						<div class="svc-right">
							<p>{s.description}</p>
							<div class="svc-button">
								<RightArrow width={18} />
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	/* SERVICES */
	.services {
		background: var(--cream);
	}

	.svc-head {
		max-width: 50rem;
		margin-bottom: 4rem;
	}

	.svc-head h2 {
		margin-bottom: 1rem;
	}

	.svc-head p {
		color: var(--brown);
		font-size: 1rem;
		opacity: 0.75;
	}
	.services h2 {
		color: var(--red);
		font-weight: 500;
	}

	.svc {
		border-top: 0.0625rem solid rgb(from var(--brown) r g b / 0.25);
		padding: 2.5rem 1.5rem;
		display: flex;
		gap: 2.5rem;
		justify-content: space-between;
	}
	.svc:last-child {
		border-bottom: 0.0625rem solid rgb(from var(--brown) r g b / 0.25);
	}

	.svc h3 {
		font-family: var(--general-sans);
		font-size: 2.5rem;
		font-weight: 500;
		color: var(--red);
	}

	.mockup {
		min-width: 6rem;
	}

	.svc-right {
		max-width: 25rem;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.svc p {
		font-size: 1rem;
		color: rgb(from var(--brown) r g b / 0.75);
		margin-bottom: 1rem;
	}

	.svc-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: 0.0625rem solid rgb(from var(--brown) r g b / 0.25);
		transition: border-color 0.25s var(--ease);
	}

	.svc:hover .svc-button {
		border-color: var(--brown) !important;
	}

	@media screen and (max-width: 767px) {
		.svc {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		.svc-right {
			align-items: flex-start;
			max-width: 100%;
		}
		.svc h3 {
			font-size: 2rem;
		}
	}
</style>
